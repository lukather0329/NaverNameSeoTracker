# 프로덕션 배포용 환경변수 템플릿입니다.
# 이 파일을 복사해서 apps/server/.env 로 저장한 뒤 실제 값으로 채워주세요.
# (.env 파일 자체는 git에 커밋하지 않습니다.)

# --- 필수 ---
# SQLite 파일 경로. 배포 서버의 실제 경로로 지정하세요. (예: 절대경로 권장)
DATABASE_URL="file:./prod.db"

# API 계정 시크릿(클라이언트 시크릿 등) 암호화에 사용하는 키입니다.
# 비워두면 시크릿이 암호화되지 않은 채로 저장되니 반드시 값을 채워주세요.
# 예: openssl rand -hex 32
ENCRYPTION_SECRET=""

# --- 선택 (기본값 그대로 써도 됨) ---
# API 서버가 열리는 포트
PORT=4300

# 상품목록 "분석 실행"이 호출하는 몬테카를로 엔진 주소.
# 엔진을 다른 서버/포트에 상시 서비스로 띄워둔 경우 그 주소로 바꿔주세요.
RW_DECISION_ENGINE_BASE_URL="http://127.0.0.1:8765"
RW_DECISION_ENGINE_API_PREFIX="/api/v1"
RW_DECISION_ENGINE_TIMEOUT_MS=10000

# 순위 추적 스케줄러가 기본으로 사용할 주기(분). (실험별로 개별 설정 가능하므로 보통 안 건드려도 됨)
RANK_TRACKING_DEFAULT_INTERVAL_MINUTES=30

# apps/web을 빌드(dist)해서 이 서버가 함께 서빙하도록 할 때 사용하는 경로.
# 기본값으로도 apps/web/dist를 자동으로 찾으므로, 보통 비워둬도 됩니다.
# WEB_BUILD_DIR="../web/dist"
